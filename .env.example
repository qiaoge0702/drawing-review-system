# AI 服务；真实密钥只写入本机 .env 或系统环境变量。
AI_PROVIDER=openai
AI_API_KEY=
AI_BASE_URL=
AI_MODEL=gpt-4

# 可选：DWG/DXF 转换器。
ODA_PATH=

# Windows + SolidWorks 真机环境使用；路径不得提交到 Git。
SW_ENTERPRISE_TEMPLATE=
SW_DRAWING_TEMPLATE=

# 通用运行配置。
LOG_LEVEL=INFO
STORAGE_UPLOAD_DIR=uploads
STORAGE_OUTPUT_DIR=output
STORAGE_TEMP_DIR=temp
